# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173
# Production must use one or more exact HTTPS frontend origins; wildcard is rejected.
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Set to the number of trusted reverse proxies in front of the API (for example, 1 behind ngrok).
TRUST_PROXY_HOPS=0

# PostgreSQL / Supabase. Use the direct or session-pooler connection string.
DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL and SUPABASE_DB_URL remain supported aliases.
# DATABASE_URL=
# SUPABASE_DB_URL=
# Set TEST_DATABASE_URL only to a disposable database before running integration tests.
# TEST_DATABASE_URL=
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
OSEAS_REQUIRE_AUTH=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=15000

# Earth Engine Cloud project and authentication
GEE_PROJECT_ID=your-earth-engine-enabled-cloud-project
GEE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=C:/secure/path/gee-service-account.json
GEE_FEATURE_PAGE_SIZE=500

# NASA FIRMS active-fire API. Empty dates use the latest one-day NRT window.
NASA_FIRMS_MAP_KEY=replace-with-server-side-firms-map-key
# Heat/fire acquisition windows and explicit screening assumptions
OSEAS_HEAT_START_DATE=2024-01-01
OSEAS_HEAT_END_DATE=2024-12-31
OSEAS_HEAT_SCREEN_THRESHOLD_C=35
OSEAS_HEAT_BASELINE_START_YEAR=2001
OSEAS_HEAT_BASELINE_END_YEAR=2020
OSEAS_FIRE_START_DATE=
OSEAS_FIRE_END_DATE=
# Empty bbox derives the request envelope from ingested Kenya county boundaries;
# returned points are also clipped to the exact county-boundary union.
OSEAS_FIRE_BBOX=
OSEAS_FIRE_SENSOR=VIIRS_SNPP_NRT
OSEAS_FIRE_PROXIMITY_KM=5
NASA_EARTHDATA_TOKEN=
# LAAD_TOKEN_NASA is also accepted as an alias for NASA_EARTHDATA_TOKEN.
# Black Marble is acquired through Earth Engine and does not require this token.
# Keep NASA_EARTHDATA_TOKEN only for NASA products that explicitly need it.
# Optional bounded Sentinel-1 event screen; do not set without a chosen event/AOI
OSEAS_FLOOD_BBOX=
OSEAS_FLOOD_EVENT_START=
OSEAS_FLOOD_EVENT_END=
OSEAS_FLOOD_BASELINE_START=
OSEAS_FLOOD_BASELINE_END=
# Operational polygon simplification tolerance; 0 disables simplification
UNOSAT_SIMPLIFY_TOLERANCE_DEGREES=0.00005
PRITHVI_MODEL_ID=ibm-nasa-geospatial/Prithvi-EO-2.0-300M-TL-Sen1Floods11
PRITHVI_MODEL_DIR=models/prithvi/flood_sen1floods11

# Asset IDs are configurable; the defaults in your private .env are based on
# the asset references supplied for OSEAS and must be verified against EE.
GEE_ASSET_KENYA_COUNTIES=
GEE_ASSET_DISTRIBUTION_TRANSFORMERS=
GEE_ASSET_EXISTING_MINI_GRIDS=
GEE_ASSET_HEALTHCARE_FACILITIES=
GEE_ASSET_MINI_GRIDS_UNDER_DEVELOPMENT=
GEE_ASSET_POWER_STATIONS=
GEE_ASSET_PRIMARY_SUBSTATIONS=
GEE_ASSET_SCHOOLS=
GEE_ASSET_TRANSMISSION_LINES_132KV=
GEE_ASSET_TRANSMISSION_LINES_220KV=
GEE_ASSET_TRANSMISSION_LINES_33KV=
GEE_ASSET_TRANSMISSION_LINES_66KV=
GEE_ASSET_UNIDENTIFIED_GRID_NETWORK=
GEE_ASSET_KENYA_WARDS=
GEE_ASSET_KENYA_RIVERS=projects/your-project/assets/kenrivers
GEE_ASSET_KENYA_LAKES=projects/your-project/assets/kenlakes
GEE_ASSET_KENYA_FLOOD_2023=projects/your-project/assets/kenya_flood_shp_2023


# 36 complete NASA VIIRS Black Marble months configured for Earth Engine processing
OSEAS_NTL_START_MONTH=2023-08
OSEAS_NTL_END_MONTH=2026-07
OSEAS_NTL_BASELINE_START_MONTH=2012-01
OSEAS_NTL_BASELINE_END_MONTH=2015-12
