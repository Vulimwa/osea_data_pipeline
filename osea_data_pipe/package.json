{
  "name": "oseas-climate-risk-pipeline",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "node --test tests/unit/*.test.js",
    "test:oseas": "python -m unittest discover -s tests/python -p test_oseas*.py",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:setup": "node scripts/setup_database.js",
    "oseas:audit": "python -m oseas.ingest --audit-only",
    "oseas:ingest": "python -m oseas.ingest",
    "oseas:status": "node scripts/oseas_status.js",
    "oseas:recover-stale": "python scripts/recover_oseas_runs.py",
    "oseas:assign-admin": "python scripts/assign_assets_admin.py",
    "oseas:catalog:audit": "python scripts/audit_oseas_datasets.py",
    "oseas:flood:unosat:audit": "python scripts/ingest_unosat_flood_reference.py --audit-only",
    "oseas:flood:unosat:ingest": "python scripts/ingest_unosat_flood_reference.py",
    "oseas:population:audit": "python scripts/download_worldpop_kenya.py --audit-only",
    "oseas:population:download": "python scripts/download_worldpop_kenya.py",
    "oseas:population:exposure": "python scripts/run_worldpop_population_exposure.py",
    "oseas:population:admin-preview": "python scripts/run_worldpop_population_exposure.py --include-administrative-units",
    "oseas:population:persist": "python scripts/run_worldpop_population_exposure.py --persist",
    "oseas:assessments": "python scripts/run_evidence_assessments.py",
    "oseas:heat": "python scripts/ingest_nasa_power_heat.py",
    "oseas:nightlights": "python scripts/ingest_viirs_black_marble.py",
    "oseas:rainfall": "python scripts/ingest_chirps_rainfall.py",
    "oseas:fire": "python scripts/ingest_firms_fire.py",
    "oseas:pipeline": "python scripts/run_oseas_pipeline.py",
    "oseas:run": "python scripts/run_oseas_pipeline.py",
    "oseas:wind:sync": "python scripts/sync_global_wind_atlas.py",
    "oseas:flood:screen": "python scripts/run_flood_screen.py",
    "oseas:prithvi:setup": "python scripts/download_prithvi_weights.py && python scripts/check_prithvi.py",
    "oseas:prithvi:flood": "python scripts/run_prithvi_flood.py",
    "oseas:prithvi:national": "python scripts/run_prithvi_national.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
